---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects } from '../../data/site';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const index = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(index + 1) % projects.length];
---
<BaseLayout title={project.title} description={project.summary}>
  <section class="project-page-hero" id="top"><div class="shell"><a href="/#work" class="back-link">← All projects</a><div class="project-hero-meta"><span class="eyebrow light">{project.eyebrow}</span><span>{project.number} / 04</span></div><h1>{project.title}<span class="period">.</span></h1><p>{project.summary}</p><div class="project-context"><span>{project.context}</span><span>{project.status}</span></div></div></section>
  <section class="project-feature shell"><ProjectVisual project={project} large={true}/><p class="image-hint">{project.image ? 'PROJECT VISUAL' : project.imageNote + ' · update the image field in src/data/site.ts'}</p></section>
  <section class="project-body section-spacing"><div class="shell project-detail-grid"><div class="project-aside"><span class="eyebrow">PROJECT OVERVIEW</span><h2>The work, in context.</h2><div class="tool-list">{project.tools.map((tool) => <span>{tool}</span>)}</div></div><div class="project-sections"><section><h3>01 / The problem</h3>{project.overview.map((item) => <p>{item}</p>)}</section><section><h3>02 / My contribution</h3><ul>{project.contribution.map((item) => <li>{item}</li>)}</ul></section><section><h3>03 / Approach</h3><ul>{project.process.map((item) => <li>{item}</li>)}</ul></section><section><h3>04 / Results & artifacts</h3><p class="editable-note">Content checklist: replace these prompts with shareable figures, specific outcomes, and verified measurements.</p><ul>{project.results.map((item) => <li>{item}</li>)}</ul><div class="artifact-placeholder"><span>CHART / SIMULATION OUTPUT PLACEHOLDER</span><span>ADD FILE IN PUBLIC/IMAGES</span></div></section></div></div></section>
  <section class="next-project"><div class="shell"><p class="eyebrow">KEEP EXPLORING</p><a href={`/projects/${next.slug}/`}><span>Next project</span><strong>{next.title} <span>↗</span></strong></a></div></section>
</BaseLayout>
